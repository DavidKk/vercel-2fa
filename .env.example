# .env.local
# Required Variables
ACCESS_USERNAME=admin
ACCESS_PASSWORD=dev-password-123
JWT_SECRET=dev-jwt-secret-key-minimum-32-chars

# Optional: included in JWT as `email` for integrators to display (OIDC-style profile)
# ACCESS_EMAIL=you@example.com

# Two-Factor Authentication (at least one required)
ACCESS_TOTP_SECRET=JBSWY3DPEHPK3PXP

# WebAuthn — open `/webauthn` in the browser on this deployment, register for the hostname in the address bar, then paste the exported one-line JSON below (or use the DEMO block).
# Single hostname: flat object. Multiple hostnames: use `byHost` or a `credentials` array — see docs/ENVIRONMENT_VARIABLES.md
# ACCESS_WEBAUTHN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# DEMO (edit for your setup; do not use as-is in production)
# ─────────────────────────────────────────────────────────────────────────────
#
# Single host (e.g. localhost only) — publicKey/credentialID must come from your /webauthn export; placeholders show shape only:
#
# ACCESS_WEBAUTHN_SECRET={"credentialID":"REPLACE_WITH_EXPORTED_ID","publicKey":"REPLACE_WITH_EXPORTED_BASE64","rpId":"localhost","username":"admin"}
#
# Multiple hosts (localhost + production) — register once per hostname at /webauthn, then nest both blobs under byHost (minify to one line in .env):
#
# ACCESS_WEBAUTHN_SECRET={"byHost":{"localhost":{"credentialID":"...","publicKey":"...","rpId":"localhost","username":"admin"},"vercel-2fa.vercel.app":{"credentialID":"...","publicKey":"...","rpId":"vercel-2fa.vercel.app","username":"admin"}}}
#
# Multiple credentials array — alternative to byHost; first entry whose rpId matches the request host wins:
#
# ACCESS_WEBAUTHN_SECRET={"credentials":[{"credentialID":"...","publicKey":"...","rpId":"localhost","username":"admin"},{"credentialID":"...","publicKey":"...","rpId":"vercel-2fa.vercel.app","username":"admin"}]}
#
# Note: rpId must match the host you used when registering (no scheme, path, or port).
# ─────────────────────────────────────────────────────────────────────────────

# Optional Configuration
JWT_EXPIRES_IN=1h

# Canonical public origin (scheme + host, no path) for Signet MCP tool responses; set when using a custom domain
# SIGNET_PUBLIC_ORIGIN=https://vercel-2fa.vercel.app

# Salt for generating user subject (sub) identifier. If not set, uses first 32 chars of JWT_SECRET
USER_SUB_SALT=dev-user-sub-salt

# Allowed Redirect URLs (comma-separated)
ALLOWED_REDIRECT_URLS=http://localhost:3000,http://localhost:3001

# ECDH Key Exchange (OAuth Flow)
ECDH_SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ECDH_SERVER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Token Replay Protection (Optional)
# ENABLE_TOKEN_REPLAY_PROTECTION=0

# Key Rotation (Optional, requires Vercel KV)
# ENABLE_KEY_ROTATION=0
# KEY_ROTATION_TTL_SECONDS=604800
# KEY_ROTATION_TRANSITION_SECONDS=86400